{
  "name": "C_StateMachine",
  "version": "1.3.0",
  "description": "Compact C finite state machine for embedded systems. Table-driven, guard/entry/exit actions, typed event data allocated from C_Allocator fixed block pools (no heap).",
  "keywords": [
    "state machine",
    "fsm",
    "embedded",
    "c",
    "fixed block allocator",
    "event driven"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/endurodave/C_StateMachine.git"
  },
  "authors": [
    {
      "name": "David Lafreniere",
      "url": "https://github.com/endurodave",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/endurodave/C_StateMachine",
  "frameworks": "*",
  "platforms": "*",
  "headers": [
    "C_StateMachine.h",
    "StateMachine.h"
  ],
  "dependencies": [
    {
      "owner": "endurodave",
      "name": "C_Allocator",
      "version": "^2.1.0"
    }
  ],
  "export": {
    "include": [
      "src",
      "examples",
      "LICENSE",
      "README.md",
      "library.json",
      "library.properties"
    ],
    "exclude": [
      "**/.pio",
      "**/.pio/**"
    ]
  },
  "build": {
    "srcDir": "src",
    "includeDir": "src"
  },
  "examples": [
    {
      "name": "c-statemachine-demo",
      "base": "examples/platformio/c-statemachine-demo",
      "files": [
        "platformio.ini",
        "src/main.cpp",
        "src/Motor.c",
        "src/Motor.h"
      ]
    },
    {
      "name": "C_StateMachine_Demo",
      "base": "examples/C_StateMachine_Demo",
      "files": [
        "C_StateMachine_Demo.ino",
        "Motor.c",
        "Motor.h"
      ]
    }
  ]
}
